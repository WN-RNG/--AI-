# Copy this file to .env for local use. On Render use Environment instead.
# Never commit .env or put keys into VITE_* variables.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_IMAGE_MODEL=qwen-image-2.1-turbo
QWEN_MONTHLY_BUDGET_CNY=50
# Conservative budget reservation, not the provider's actual price.
QWEN_RESERVE_PER_IMAGE_CNY=0.60
